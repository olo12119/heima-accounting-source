{
  "name": "heima-accounting",
  "version": "1.3.0",
  "private": true,
  "description": "黑马记账——本地优先、无需登录的个人桌面记账软件",
  "main": "./out/main/index.mjs",
  "author": "Heima Accounting",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.85.5",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.1",
    "recharts": "^3.1.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  }
}
